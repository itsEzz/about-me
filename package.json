{
	"name": "about-me",
	"description": "A personal portfolio/about-me website built with SvelteKit",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/about-me#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/about-me.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/about-me/issues"
	},
	"keywords": [
		"portfolio",
		"personal-website",
		"sveltekit",
		"typescript"
	],
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"sc:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/cli": "^3.0.0",
		"@inlang/paraglide-js": "^2.25.0",
		"@internationalized/date": "^3.12.3",
		"@itsezz/try-catch": "^1.4.0",
		"@lucide/svelte": "^1.35.0",
		"@svelte-put/cloudflare-turnstile": "^1.2.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"formsnap": "^2.0.1",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.5.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.2.1",
		"sveltekit-rate-limiter": "^0.8.0",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.0.16",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"ogl": "^1.0.11",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0"
	}
}
