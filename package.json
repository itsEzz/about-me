{
	"name": "about-me",
	"version": "1.0.0",
	"description": "A personal portfolio/about-me website built with SvelteKit",
	"type": "module",
	"private": true,
	"author": "@itsEzz",
	"license": "MIT",
	"homepage": "https://github.com/itsEzz/about-me#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/itsEzz/about-me.git"
	},
	"bugs": {
		"url": "https://github.com/itsEzz/about-me/issues"
	},
	"keywords": [
		"portfolio",
		"personal-website",
		"sveltekit",
		"typescript"
	],
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"scs:update": "pnpm dlx shadcn-svelte@latest update"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.1",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.10.1",
		"@itsezz/try-catch": "^1.2.0",
		"@lucide/svelte": "^0.563.1",
		"@svelte-put/cloudflare-turnstile": "^1.2.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.1",
		"@sveltejs/kit": "^2.49.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/nodemailer": "^7.0.5",
		"bits-ui": "^2.15.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"formsnap": "^2.0.1",
		"globals": "^17.0.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^8.0.1",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.0.7",
		"sveltekit-rate-limiter": "^0.7.0",
		"sveltekit-superforms": "^2.29.1",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.53.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^7.3.1",
		"zod": "^4.3.5"
	},
	"dependencies": {
		"pino": "^10.3.0",
		"pino-pretty": "^13.1.3",
		"pino-roll": "^4.0.0"
	}
}
